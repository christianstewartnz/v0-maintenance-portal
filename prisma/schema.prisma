generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String    @id
  userId      String
  name        String
  address     String    @default("")
  description String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  units      Unit[]
  requests   MaintenanceRequest[]
  items      Item[]
  workOrders WorkOrder[]

  @@index([userId])
}

model Unit {
  id         String    @id
  projectId  String
  unitNumber String
  address    String
  archivedAt DateTime?
  ownerName  String?
  ownerEmail String?
  ownerPhone String?

  project          Project              @relation(fields: [projectId], references: [id])
  detectedRequests MaintenanceRequest[]
  items            Item[]

  @@index([projectId])
}

enum RequestStatus {
  needs_review
  processed
  error
  archived
}

model MaintenanceRequest {
  id             String        @id
  projectId      String?
  fromName       String
  fromEmail      String
  fromPhone      String?
  subject        String
  bodyRaw        String
  receivedAt     DateTime
  status         RequestStatus @default(needs_review)
  detectedUnitId String?

  project      Project? @relation(fields: [projectId], references: [id])
  detectedUnit Unit?    @relation(fields: [detectedUnitId], references: [id])
  items        Item[]
  attachments  MaintenanceAttachment[]

  @@index([projectId])
  @@index([detectedUnitId])
}

model MaintenanceAttachment {
  id          String   @id @default(uuid())
  requestId   String
  fileName    String
  mimeType    String
  storagePath String
  createdAt   DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}

enum Trade {
  Plumbing
  Electrical
  Carpentry
  Painting
  Appliance
  General
  Other
}

enum Priority {
  Low
  Normal
  Urgent
}

enum ItemStatus {
  New
  Assigned
  InProgress                @map("In Progress")
  MarkedCompleteNeedsReview
  Completed
  Closed
}

enum WorkOrderStatus {
  Draft
  Issued
  InProgress
  Completed
  Closed
}

model Item {
  id          String     @id
  projectId   String
  requestId   String?
  unitId      String
  title       String
  description String
  otherNotes  String?
  trade       Trade
  priority    Priority
  status      ItemStatus @default(New)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project        Project            @relation(fields: [projectId], references: [id])
  request        MaintenanceRequest? @relation(fields: [requestId], references: [id])
  unit           Unit               @relation(fields: [unitId], references: [id])
  workOrderItems WorkOrderItem[]
  activities     ItemActivity[]

  @@index([projectId])
  @@index([requestId])
  @@index([unitId])
}

model Contractor {
  id          String      @id @default(uuid())
  userId      String?
  name        String
  contactName String
  email       String
  phone       String?
  trade       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workOrders WorkOrder[]

  @@index([userId])
}

model WorkOrder {
  id           String          @id @default(uuid())
  reference    String          @unique
  projectId    String
  contractorId String
  status       WorkOrderStatus @default(Draft)
  issuedAt     DateTime?
  completedAt  DateTime?
  closedAt     DateTime?
  accessNotes  String?
  messageBody  String?
  createdAt    DateTime        @default(now())

  project    Project           @relation(fields: [projectId], references: [id])
  contractor Contractor        @relation(fields: [contractorId], references: [id])
  items      WorkOrderItem[]
  access     WorkOrderAccess[]

  @@index([projectId])
  @@index([contractorId])
}

model WorkOrderItem {
  id                      String    @id @default(uuid())
  workOrderId             String
  itemId                  String
  isCompletedByContractor Boolean   @default(false)
  completedAt             DateTime?
  completionNotes         String?
  createdAt               DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([workOrderId, itemId])
  @@index([workOrderId])
  @@index([itemId])
}

model WorkOrderAccess {
  id          String   @id @default(uuid())
  workOrderId String
  token       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model ItemActivity {
  id        String   @id @default(uuid())
  itemId    String
  message   String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId])
}
